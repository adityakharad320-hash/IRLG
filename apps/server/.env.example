# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
API_PREFIX=/api/v1

# Security & CORS (comma-separated origins supported)
CORS_ORIGIN=http://localhost:3000

# Supabase (PostgreSQL & Auth)
# Required for database connectivity and auth verification.
# Server starts in degraded/unconfigured mode if omitted.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
