# Supabase Configuration (Public / Browser-safe)
# Obtain these from your Supabase Dashboard -> Project Settings -> API.
# Note: Use only the anon/publishable key. Never place service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# IRLG Backend API Configuration
# Points to the Fastify backend server API prefix
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
